{
  "name": "music-recognizer",
  "version": "0.0.0",
  "description": "Song recognition library with Shazam, AudD, ACRCloud, streaming links, and lyrics.",
  "keywords": [
    "music-recognition",
    "shazam",
    "audd",
    "acrcloud",
    "audio-fingerprint",
    "shazam-algorithm",
    "song-recognition",
    "odesli",
    "lrclib",
    "lyrics"
  ],
  "homepage": "https://github.com/shahradelahi/music-recognizer",
  "repository": "github:shahradelahi/music-recognizer",
  "license": "GPL-3.0",
  "author": "Shahrad Elahi <shahrad@litehex.com> (https://github.com/shahradelahi)",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.cjs"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**",
    "!**/*.d.cts"
  ],
  "scripts": {
    "bench": "vitest bench --run",
    "build": "tsup",
    "clean": "git clean -dfx node_modules dist .tsbuildinfo",
    "dev": "tsup --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm typecheck && eslint .",
    "lint:fix": "eslint --fix .",
    "prepublishOnly": "pnpm build && pnpm lint && pnpm format:check && pnpm test",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit"
  },
  "prettier": "@shahrad/prettier-config",
  "dependencies": {
    "@se-oss/base64": "^1.0.3",
    "@se-oss/crc32": "^1.0.0",
    "@se-oss/uuid": "^1.0.0"
  },
  "devDependencies": {
    "@shahrad/eslint-config": "^1.0.1",
    "@shahrad/prettier-config": "^1.2.2",
    "@shahrad/tsconfig": "^1.2.0",
    "@types/node": "^24.7.0",
    "eslint": "^9.37.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "tsup": "^9.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.15.0"
}
